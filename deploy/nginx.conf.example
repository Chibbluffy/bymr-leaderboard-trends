# nginx server block for BYM Leaderboard Trends, reverse-proxying everything
# to server.py (default port 8082). Copy this to somewhere like
# /etc/nginx/sites-available/bymr-leaderboard.chibbluffy.fyi, symlink it into
# sites-enabled/, then `sudo nginx -t && sudo systemctl reload nginx`.
#
# A subdomain, not a path prefix, is what this file assumes — every asset
# and API path in the app (/styles.css, /app.js, /api/worlds, ...) is
# root-relative, so this subdomain needs to own the whole path space. A
# shared path like example.com/leaderboard/ would need code changes first.
#
# HTTPS: this only sets up plain HTTP on :80. The standard next step is
# `sudo certbot --nginx -d bymr-leaderboard.chibbluffy.fyi`, which rewrites
# this file in place to add the certificate + a :443 server block and an
# HTTP->HTTPS redirect — run that after this config is confirmed working
# over HTTP.

server {
    listen 80;
    listen [::]:80;
    server_name bymr-leaderboard.chibbluffy.fyi;

    location / {
        proxy_pass http://127.0.0.1:8082;  # <-- change the port if you changed PORT in .env
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # server.py already sends Cache-Control: no-store on every response
        # (see its end_headers() override) — nothing extra needed here.
    }
}
